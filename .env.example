# ---------------------------------------------------------------------------
# EyeCash – configuration. Copy to .env (install.sh does it for you).
# Everything is OPTIONAL: without an AI provider the app works fully and no
# data ever leaves your server. Easiest way to set up the AI: bash setup-ai.sh
# ---------------------------------------------------------------------------

# Timezone used for dates and daily backups
# APP_TZ=Europe/Rome

# --- Option 1: LOCAL model with Ollama (nothing leaves your network) --------
# Ollama started by docker compose (--profile ollama):
# AI_PROVIDER=ollama
# OLLAMA_URL=http://ollama:11434
# AI_MODEL=qwen3:8b
# Ollama already installed on the host instead:
# OLLAMA_URL=http://host.docker.internal:11434

# --- Option 2: other local servers (LM Studio, llama.cpp, vLLM) -------------
# AI_PROVIDER=local
# OPENAI_BASE_URL=http://host.docker.internal:1234/v1
# AI_MODEL=model-name

# --- Option 3: Anthropic (Claude). Also enables reading PDF statements ------
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-sonnet-5-5
# AI_MODEL_FAST=claude-haiku-5-5
# Web search for car/home value estimates (about 1 cent per search, max 5 per estimate):
# AI_WEB_SEARCH=true

# --- Option 4: any OpenAI-compatible cloud API (OpenAI, OpenRouter, Mistral…) -
# AI_PROVIDER=openai
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# AI_MODEL=model-name

# Seconds to wait for an AI reply (default 300, 600 for local models)
# AI_TIMEOUT=600

# Automatic investment prices from public sources (on by default; only tickers/ISINs leave)
# QUOTES_ENABLED=false
